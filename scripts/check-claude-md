#!/usr/bin/env bash
# Verify CLAUDE.md CLI commands section is up-to-date
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/_env.sh"

CLAUDE_MD="$SCRIPT_DIR/CLAUDE.md"

expected=$(php "$SCRIPT_DIR/scripts/listing.php")

# Extract what's currently in the fenced block
actual=$(sed -n '/^```$/,/^```$/{//d;p;}' "$CLAUDE_MD")

if [[ "$expected" != "$actual" ]]; then
    echo "CLAUDE.md CLI commands section is out of date." >&2
    echo "Run composer generate-claude-md to update." >&2
    exit 1
fi

echo "CLAUDE.md CLI commands section is up-to-date."
