#!/usr/bin/env bash
# Generate public API section in README.md from the package CLI
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
export SCRIPT_DIR
README="$SCRIPT_DIR/README.md"

SECTION_START="## Cli"
SECTION_END="<!-- end public api -->"

# CLI name comes from the manifest (sdk.json), never hardcoded here
cli=$(php -r 'require getenv("SCRIPT_DIR")."/scripts/manifest.php"; echo manifestString("bin");')

# Capture API listing
api_output=$("$SCRIPT_DIR/run" "$cli" 2>/dev/null | tail -n +2 || true)

# Build the new section
new_section="$SECTION_START

\`\`\`bash
./vendor/bin/$cli
\`\`\`

\`\`\`
$api_output
\`\`\`

$SECTION_END"

if [[ -f "$README" ]] && grep -q "$SECTION_START" "$README"; then
    # Replace existing section using line-number based extraction
    tmpfile=$(mktemp)
    start_line=$(grep -n "^${SECTION_START}$" "$README" | head -1 | cut -d: -f1)
    end_line=$(grep -n "^${SECTION_END}$" "$README" | head -1 | cut -d: -f1)

    # Content before the section
    if (( start_line > 1 )); then
        head -n $(( start_line - 1 )) "$README" > "$tmpfile"
    else
        : > "$tmpfile"
    fi

    # New section
    printf '%s\n' "$new_section" >> "$tmpfile"

    # Content after the section
    tail -n +"$(( end_line + 1 ))" "$README" >> "$tmpfile"

    mv "$tmpfile" "$README"
else
    # Append section (with leading newline if file is non-empty)
    if [[ -s "$README" ]]; then
        printf '\n%s\n' "$new_section" >> "$README"
    else
        printf '%s\n' "$new_section" > "$README"
    fi
fi

echo "Updated $README"