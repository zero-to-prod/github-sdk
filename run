#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

export SCRIPT_DIR

# Load .env
if [[ -f "$SCRIPT_DIR/.env" ]]; then
    source "$SCRIPT_DIR/.env"
fi

export PHP_VERSION="${PHP_VERSION:-8.1}"

COMMAND="${1:-}"

if [[ -z "$COMMAND" || "$COMMAND" == "list" ]]; then
    echo "Usage: ./run <command>"
    echo ""
    echo "Commands:"
    for script in "$SCRIPT_DIR/scripts/"*; do
        [[ -x "$script" ]] || continue
        name="$(basename "$script")"
        # Read description from second line comment
        desc=$(sed -n '2s/^# *//p' "$script")
        printf "  %-14s %s\n" "$name" "$desc"
        # Read flag lines (# --flag  description)
        sed -n '3,/^[^#]/{ s/^# *\(--.*\)/\1/p; }' "$script" | while read -r flag; do
            printf "  %-14s   %s\n" "" "$flag"
        done
    done
    exit 1
fi

# Map colon syntax to file: test:all -> test-all
SCRIPT="$SCRIPT_DIR/scripts/${COMMAND//:/-}"

if [[ ! -x "$SCRIPT" ]]; then
    echo "Unknown command: $COMMAND" >&2
    exit 1
fi

shift
echo "==> ${SCRIPT#"$SCRIPT_DIR/"} $*"
exec "$SCRIPT" "$@"
