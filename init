/** @param list<string> $removed */
function report_removed(array $removed): void
{
    if ($removed === []) {
        return;
    }

    writeln('');
    writeln('  Removed:');

    foreach ($removed as $path) {
        writeln('    '.$path);
    }
}

/** @param array<string, string> $answers */
function next_steps(array $answers): void
{
    $repository = repository($answers) !== '' ? repository($answers) : 'https://github.com/<org>/'.$answers['slug'];

    writeln('');
    writeln('  Next:');
    writeln('');
    writeln('    # README.md still describes the template, not '.composer_name($answers).'.');
    writeln('    # Rewrite it for this package — its examples are no longer verified by a test,');
    writeln('    # because ReadmeExamplesTest went with the template content it mirrored.');
    writeln('');
    writeln('    # sdk.json now carries base_url ('.($answers['base_url'] !== '' ? $answers['base_url'] : '(not set)').').');
    writeln('    # '.$answers['config_class'].'::url still defaults to an empty string so tests need no host;');
    writeln('    # pass the base URL explicitly, or read it from sdk.json in your own bootstrap.');
    writeln('');
    writeln('    # Keep the template as an ancestor you can merge from, forever:');
    writeln('    git remote rename origin template          # when this repo was cloned from the template');
    writeln('    gh repo create '.trim(str_replace('https://github.com/', '', $repository)).' --source=. --remote=origin');
    writeln('    git config merge.keepours.driver true      # once per clone, or merges resolve wrongly and silently');
    writeln('');
    writeln('    # Then, from now on:');
    writeln('    git pull template main   # never --rebase: it destroys the shared ancestry');
    writeln('');
    writeln('    ./run init && ./run check-all');
    writeln('');
    writeln('  See docs/template.md for the full runbook.');
    writeln('');
}

function usage(): void
{
    writeln('');
    writeln('  Usage: php init [options]');
    writeln('');
    writeln('    -n, --defaults        accept every computed default without prompting');
    writeln('    --answers=<path>      read answers from a JSON object, no prompting');
    writeln('    -h, --help            show this message');
    writeln('');
    writeln('  Answer keys: '.implode(', ', ANSWER_KEYS));
    writeln('');
}

function writeln(string $line): void
{
    echo $line, PHP_EOL;
}

/*
|------------------------------------------------------------------------------
| Helpers
|------------------------------------------------------------------------------
*/

/** Non-interactive mode: every prompt takes its default and every confirm says yes. */
function auto(?bool $enable = null): bool
{
    static $auto = false;

    if ($enable !== null) {
        $auto = $enable;
    }

    return $auto;
}

function ask(string $question, string $default): string
{
    if (auto()) {
        return $default;
    }

    echo sprintf('  %s [%s]: ', $question, $default !== '' ? $default : '-');
    $answer = trim((string) fgets(STDIN));

    return $answer === '' ? $default : $answer;
}

function confirm(string $question, bool $default = false): bool
{
    if (auto()) {
        return $default;
    }

    echo sprintf('  %s? [%s] ', $question, $default ? 'Y/n' : 'y/N');
    $answer = strtolower(trim((string) fgets(STDIN)));

    return $answer === '' ? $default : in_array($answer, ['y', 'yes'], true);
}

function git(string $arguments): string
{
    return trim((string) shell_exec('git '.$arguments.' 2>/dev/null'));
}

function slugify(string $value): string
{
    return trim((string) preg_replace('/-+/', '-', (string) preg_replace('/[^a-z0-9]+/', '-', strtolower($value))), '-');
}

function titleise(string $value): string
{
    return ucwords((string) preg_replace('/[^a-zA-Z0-9]+/', ' ', $value));
}

/** `github-api` -> `GithubApi` */
function studly(string $value): string
{
    return str_replace(' ', '', titleise(strtolower($value)));
}

/**
 * A vendor becomes one namespace segment rather than one per word, which is
 * what makes `zero-to-prod` read as `Zerotoprod` and not `ZeroToProd`.
 */
function condense(string $value): string
{
    return ucfirst(strtolower((string) preg_replace('/[^a-zA-Z0-9]+/', '', $value)));
}

function namespace_for(string $vendor, string $slug): string
{
    $root = condense($vendor);
    $package = studly($slug) ?: studly(TEMPLATE['slug']);

    return $root === '' ? $package : $root.'\\'.$package;
}

/** Exactly one trailing `Api`: `github-api` -> `GithubApi`, `stripe` -> `StripeApi`. */
function api_class_for(string $slug): string
{
    $studly = studly($slug);

    if ($studly === '') {
        return TEMPLATE['api_class'];
    }

    return str_ends_with($studly, 'Api') ? $studly : $studly.'Api';
}

function config_class_for(string $api_class): string
{
    return str_ends_with($api_class, 'Api')
        ? substr($api_class, 0, -3).'Config'
        : $api_class.'Config';
}

/** @param array<string, string> $answers */
function composer_name(array $answers): string
{
    return ($answers['vendor'] !== '' ? $answers['vendor'] : 'app').'/'.$answers['slug'];
}

/** @param array<string, string> $answers */
function repository(array $answers): string
{
    return $answers['vendor'] === '' ? '' : 'https://github.com/'.$answers['vendor'].'/'.$answers['slug'];
}

/** @param array<string, string> $answers */
function author(array $answers): string
{
    return trim($answers['author'].($answers['author_email'] === '' ? '' : ' <'.$answers['author_email'].'>'));
}

/**
 * @param  array<string, string>  $answers
 * @return array{name: string, email?: string, role?: string}|null
 */
function author_record(array $answers): ?array
{
    if ($answers['author'] === '') {
        return null;
    }

    /** @var array{name: string, email?: string, role?: string} $record */
    $record = array_filter([
        'name' => $answers['author'],
        'email' => $answers['author_email'],
    ]);

    return $record;
}
