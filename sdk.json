{
    "$comment": "Template manifest. `php init` rewrites this for a derived package; the tooling in scripts/ reads it.",
    "name": "zero-to-prod/github-sdk",
    "namespace": "Zerotoprod\\GitHubSdk",
    "title": "Github Sdk",
    "description": "GitHub Sdk",
    "api_class": "GitHubSdk",
    "config_class": "GitHubSdkConfig",
    "bin": "github-sdk",
    "base_url": "https://api.github.com",
    "docs_url": "https://docs.github.com/",
    "retain_models": [
        "Errors",
        "Pagination",
        "Query"
    ],
    "openapi": {
        "source": "https://raw.githubusercontent.com/github/rest-api-description/main/descriptions/api.github.com/api.github.com.json",
        "include_webhooks": false,
        "envelope_key": null
    }
}
